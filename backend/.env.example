# Clé secrète JWT (changez en production !)
SECRET_KEY=escargot-crm-secret-key-changez-moi

# Base de données
# SQLite local (défaut) :
DATABASE_URL=sqlite:///./escargot_crm.db
# PostgreSQL Render (production) :
# DATABASE_URL=postgresql://user:password@host/dbname

# Origines CORS autorisées (séparées par virgule, ou * pour tout)
ALLOWED_ORIGINS=*
